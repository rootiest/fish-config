# CLASSIFICATION
#   bypasses-shadow(mkdir,cp,mv,rm)
#
# SYNOPSIS
#   __fish_template_write [--force|--managed] NAME SRC DIR
#
# DESCRIPTION
#   Installs generated function SRC as DIR/NAME.fish. An existing file is
#   refused unless --force, or unless --managed (edit/regen) and the file
#   carries the fish-template recipe marker; a hand-written function is
#   never replaced. SRC must pass fish -n and fish_indent --check, or
#   nothing is written and the code goes to stderr as a bug report.
#   Warns when NAME shadows a builtin, another function or a binary
#   (a function wrapping a command of its own name gets a note instead).
#   The file is written via a temp file and mv, DIR is added to
#   $fish_function_path if missing, and the new file is sourced, so the
#   function works immediately.
#
# EXIT STATUS
#   0  Written
#   1  Refused, invalid code, or a write error
function __fish_template_write --description 'Install a function generated by fish-template'
    argparse force managed -- $argv; or return 2
    set -l name $argv[1]
    set -l src $argv[2]
    set -l dir $argv[3]
    set -l dest $dir/$name.fish
    __fish_palette

    if test -e $dest
        if set -q _flag_managed
            if not string match -q -- '*# ── fish-template recipe ──*' <$dest
                echo "$c_err""fish-template: $dest was not made by fish-template; leaving it alone$c_reset" >&2
                return 1
            end
        else if not set -q _flag_force
            echo "$c_err""fish-template: $dest already exists (add --force to replace it)$c_reset" >&2
            return 1
        end
    end
    if not fish -n $src 2>/dev/null; or not fish_indent --check <$src >/dev/null 2>&1
        echo "$c_err""fish-template: the generated code failed fish -n or fish_indent --check, so nothing was written. Please report this fish-template bug with this code:$c_reset" >&2
        string collect -N <$src >&2
        return 1
    end

    if test "$__ftv___ft_use[1]" = command; and test "$__ftv_command_cmd[1]" = $name
        echo "$c_dim""note: $name wraps the $name command of the same name$c_reset" >&2
    else if builtin -q $name
        echo "$c_warn""warning: $name shadows the fish builtin $name$c_reset" >&2
    else if functions -q $name; and test "$(functions -D $name)" != $dest
        echo "$c_warn""warning: $name overrides the function in $(functions -D $name)$c_reset" >&2
    else if command -q $name
        echo "$c_warn""warning: $name shadows $(command -s $name)$c_reset" >&2
    end

    command mkdir -p $dir; or return 1
    set -l tmp (mktemp $dir/.$name.XXXXXX); or return 1
    if not command cp -- $src $tmp; or not command mv -f -- $tmp $dest
        command rm -f -- $tmp
        echo "$c_err""fish-template: could not write $dest$c_reset" >&2
        return 1
    end
    contains -- $dir $fish_function_path; or set -g fish_function_path $dir $fish_function_path
    if not source $dest
        command rm -f -- $dest
        echo "$c_err""fish-template: fish could not load the generated function, so $dest was removed$c_reset" >&2
        return 1
    end
    echo "$c_ok✓$c_reset $c_cmd$name$c_reset is ready ($dest). Try: $name --help"
    return 0
end
