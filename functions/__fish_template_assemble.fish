# SYNOPSIS
#   __fish_template_assemble NAME
#
# DESCRIPTION
#   Prints the complete function file for the (validated) recipe in the
#   store: a documentation header composed from each template's PHRASE,
#   STATUS, SYNOPSIS and EXAMPLE; `function NAME` with a literal name; a
#   --help guard (omitted when NAME wraps a command of the same name, which
#   owns its help); the recipe as literal `set -l` lines between the recipe
#   markers; and the fragments in canonical order:
#
#     guard    target, then modifiers
#     seed     target
#     prepare  modifiers by ORDER
#     run      target, inside the retry loop, piped through tee when the
#              log modifier is used
#     finally  modifiers by ORDER
#
#   Fragments are pasted verbatim and the result is formatted by
#   fish_indent. __ft_use is rewritten in canonical order.
#
# EXIT STATUS
#   Exit status of fish_indent; 2 if a template is missing
function __fish_template_assemble --argument-names name --description 'Print the function a fish-template recipe describes'
    set -l use $__ftv___ft_use
    set -l target $use[1]
    set -l tfile (__fish_template_file $target); or return 2

    set -l keyed
    for m in $use[2..]
        set -l f (__fish_template_file $m); or return 2
        set -a keyed (printf '%03d\t%s' (__fish_template_meta $f ORDER) $m)
    end
    set -l mods (path sort -- $keyed | string replace -r -- '^[0-9]+\t' '')
    __fish_template_store set __ft_use $target $mods
    set -l names $target $mods
    set -l files $tfile
    for m in $mods
        set -a files (__fish_template_file $m)
    end

    #   ── Header ──
    set -l lead (__fish_template_phrase $tfile PHRASE $name)
    set -l desc $lead
    for f in $files[2..]
        set desc "$desc, "(__fish_template_phrase $f PHRASE $name)
    end
    set desc "$desc."
    set -l short $lead
    set -q mods[1]; and set short "$lead ("(string join ', ' -- $mods)")"

    set -l wrapped
    set -l line ''
    for w in (string split -n ' ' -- $desc)
        if test -n "$line"; and test (string length -- "$line $w") -gt 72
            set -a wrapped "#   $line"
            set line $w
        else if test -n "$line"
            set line "$line $w"
        else
            set line $w
        end
    end
    test -n "$line"; and set -a wrapped "#   $line"

    set -l out '# SYNOPSIS' "#   $(__fish_template_phrase $tfile SYNOPSIS $name)" '#' \
        '# DESCRIPTION' $wrapped '#' '# EXIT STATUS'
    for f in $files
        set -l s (__fish_template_phrase $f STATUS $name); and set -a out "#   $s"
    end
    set -a out '#' '# EXAMPLE' "#   $(__fish_template_phrase $tfile EXAMPLE $name)" '#' \
        '# NOTES' \
        "#   Generated by fish-template from: $(string join ' ' -- $names)." \
        "#   Change it with: fish-template edit $name"

    #   ── Function line and help guard ──
    set -l fline "function $name --description "(string escape -- $short)
    test $target = command; and set fline "$fline --wraps="(string escape -- $__ftv_command_cmd[1])
    set -a out $fline
    if not test $target = command -a "$__ftv_command_cmd[1]" = $name
        set -a out 'if functions -q __fish_help_header' \
            '__fish_help_header (status current-function) $argv; and return 0' end ''
    end

    #   ── Recipe ──
    set -a out '# ── fish-template recipe ──' (__fish_template_store emit __ft_use)
    for f in $files
        for row in (__fish_template_settings $f)
            set -a out (__fish_template_store emit (string split -f1 \t -- $row))
        end
    end
    set -a out '# ── end recipe ──' ''

    #   ── Core state ──
    set -a out 'set -l cmd' 'set -l __ft_attempts 1' 'set -l __ft_delay 0' 'set -l __ft_log' \
        'set -l __ft_tee_flag -a' 'set -l __ft_append' 'set -l __ft_prev_dir' 'set -l __ft_status 0'

    #   ── Phases ──
    for i in (seq (count $files))
        set -l frag (__fish_template_fragment $files[$i] guard)
        and set -a out '' "# $names[$i]: guard" $frag
    end
    set -l frag (__fish_template_fragment $tfile seed)
    and set -a out '' "# $target: seed" $frag
    for i in (seq (count $files))
        test $i -eq 1; and continue
        set -l frag (__fish_template_fragment $files[$i] prepare)
        and set -a out '' "# $names[$i]: prepare" $frag
    end
    set -l run (__fish_template_fragment $tfile run)
    set -a out '' "# $target: run" 'for __ft_try in (seq $__ft_attempts)'
    if contains -- log $mods
        set -a out begin $run 'end 2>&1 | command tee $__ft_tee_flag $__ft_log' 'set __ft_tee_flag -a'
    else
        set -a out $run
    end
    set -a out 'test $__ft_status -eq 0; and break' \
        'test $__ft_try -lt $__ft_attempts; and sleep $__ft_delay' end
    for i in (seq (count $files))
        test $i -eq 1; and continue
        set -l frag (__fish_template_fragment $files[$i] finally)
        and set -a out '' "# $names[$i]: finally" $frag
    end
    set -a out '' 'return $__ft_status' end
    printf '%s\n' $out | fish_indent
end
